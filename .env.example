# Copy this file to .env and adjust as needed.

# Postgres and Redis from `docker compose up -d` (ports are offset to avoid clashing with local installs)
DATABASE_URL=postgres://pulse:pulse@localhost:5433/pulse
REDIS_URL=redis://localhost:6380

# Password for the dashboard. Leave empty to run without login (local development only!)
PULSE_ADMIN_PASSWORD=

# Secret used to sign the session cookie. Set a long random string in production.
PULSE_SECRET=

# Bearer token for the REST API (/api/monitors). The API is disabled while this is empty.
PULSE_API_KEY=

# How many days of raw check results to keep
RETENTION_DAYS=30

# How many checks the worker runs in parallel
WORKER_CONCURRENCY=10
